rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un solo accesso per tutti e tre: nome utente "agenda_lavoro".
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email == 'agenda_lavoro@daje.it';
    }

    // Tutti i dati dell'agenda: profili, appuntamenti, rubrica.
    match /agenda/principale/{col}/{id} {
      allow read, write: if autorizzato()
        && col in ['profiles', 'appts', 'contacts'];
    }
    // Tutto il resto è chiuso.
  }
}
